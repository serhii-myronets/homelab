#!/bin/sh /etc/rc.common
# Gatus on the router. Installed and updated by router/gatus/install.sh from
# the Mac; nothing here reaches out for changes. See docs/decisions/0036.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /opt/gatus/gatus
	# /etc/gatus/env holds what must not be in Git - the Telegram token and
	# the healthchecks.io URL - as KEY=value lines, one per line, no spaces.
	procd_set_param env GATUS_CONFIG_PATH=/etc/gatus/config.yaml \
		SSL_CERT_DIR=/etc/gatus/certs \
		$(grep -E '^[A-Z_]+=' /etc/gatus/env 2>/dev/null)
	procd_set_param user nobody
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
